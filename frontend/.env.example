# Corgi Hop — environment placeholders (TEST MODE).
#
# NEVER commit real values. This file is safe to commit; the real .env is
# git-ignored (see .gitignore).
#
# Development behaviour:
#   • Empty values below → the app uses Google's official DEMO ad-unit IDs
#     and RevenueCat is left uninitialised (no purchases happen). Browser
#     preview keeps its mock services (see src/services/).
#   • Vite exposes only `VITE_*` names to the client. SECRET REVENUECAT REST
#     KEYS MUST NEVER APPEAR HERE — this file is bundled with the app.
#
# Production release checklist (enforce in the release pipeline BEFORE
# archiving / uploading to Play Console):
#   □ VITE_APP_ENV=production
#   □ VITE_ENABLE_PRODUCTION_MONETIZATION=true
#   □ VITE_USE_AD_TEST_IDS=false (or unset)
#   □ VITE_SHOW_TEST_ADS_LABEL=false
#   □ All VITE_ADMOB_* IDs are real (no ca-app-pub-3940256099942544 anywhere)
#   □ Both VITE_REVENUECAT_*_PUBLIC_KEY values are set
#   □ VITE_PRIVACY_POLICY_URL / VITE_TERMS_URL / VITE_SUPPORT_URL /
#     VITE_MARKETING_URL are non-empty HTTPS URLs

# ---- App environment ----
VITE_APP_ENV=development
VITE_ENABLE_PRODUCTION_MONETIZATION=false
VITE_SHOW_TEST_ADS_LABEL=true

# ---- RevenueCat (public SDK keys only!) ----
# SDK pinned at 9.2.2 (Capacitor 6 compatible). No Test-Store fallback on
# this SDK version — real sandbox purchases require the App Store In-App
# Purchase Key uploaded to the RevenueCat dashboard (iOS) and a signed
# Play Internal Testing build (Android).
VITE_REVENUECAT_IOS_PUBLIC_KEY=
VITE_REVENUECAT_ANDROID_PUBLIC_KEY=

# ---- AdMob ----
# App IDs (from AdMob Console → Apps → App settings). Also mirrored into
# ios/App/App/Info.plist (GADApplicationIdentifier) and
# android/app/src/main/AndroidManifest.xml (com.google.android.gms.ads.APPLICATION_ID).
VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_ANDROID_APP_ID=

# Ad-unit IDs. Blank → Google's official DEMO IDs are used at runtime.
VITE_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-3940256099942544/4411468910
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
VITE_ADMOB_IOS_REWARDED_ID=ca-app-pub-3940256099942544/1712485313
VITE_ADMOB_ANDROID_REWARDED_ID=ca-app-pub-3940256099942544/5224354917

# Comma-separated hashed device IDs from `adb logcat` / Xcode console —
# real-device testing then serves TEST creatives even when live IDs are set.
VITE_ADMOB_TEST_DEVICE_IDS=

# Force test IDs at runtime even when real IDs are set (extra safety switch
# for CI / debug builds). "true" to enable.
VITE_USE_AD_TEST_IDS=

# ---- Product identifiers (must match App Store Connect / Play Console) ----
VITE_PRODUCT_REMOVE_ADS=com.corgihop.remove_ads
VITE_PRODUCT_STARTER_PACK=com.corgihop.starter_pack
VITE_PRODUCT_PREMIUM_CORGIS=com.corgihop.premium_corgis
VITE_PRODUCT_ALL_CORGIS=com.corgihop.all_corgis

# ---- Public legal / store URLs (required before store submission) ----
# All must be reachable HTTPS URLs owned by you. Store review WILL reject
# empty values or placeholders like example.com.
VITE_PRIVACY_POLICY_URL=
VITE_TERMS_URL=
VITE_SUPPORT_URL=
VITE_MARKETING_URL=
