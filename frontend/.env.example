# Native monetization — TEST-ONLY placeholders. Fill in real values before
# generating the store build. NEVER commit real keys — this file is
# git-ignored via /app/frontend/.env* (see .gitignore).
#
# Development behaviour:
#   • Empty values below → the app uses Google's official DEMO ad-unit IDs
#     and RevenueCat "test store" configuration where supported.
#   • Vite exposes only `VITE_*` names to the client. SECRET REVENUECAT REST
#     KEYS MUST NEVER APPEAR HERE — this file is bundled with the app.

# ---- RevenueCat (public SDK keys only!) ----
VITE_REVENUECAT_IOS_PUBLIC_KEY=
VITE_REVENUECAT_ANDROID_PUBLIC_KEY=
# Optional single test-store key (only supported by RevenueCat v13.2+ if
# `useAmazonApi=false` and the project has a Test Store enabled).
VITE_REVENUECAT_TEST_PUBLIC_KEY=

# ---- AdMob ----
# App IDs (from AdMob Console → Apps → App settings).
VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_ANDROID_APP_ID=
# Ad-unit IDs (from AdMob Console → Ad units). Leave empty to use Google's
# official demo IDs during development.
VITE_ADMOB_IOS_INTERSTITIAL_ID=
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=
VITE_ADMOB_IOS_REWARDED_ID=
VITE_ADMOB_ANDROID_REWARDED_ID=

# Register real physical test devices here (comma-separated hashed device
# IDs from logcat / Xcode) so live-key testing on a real device serves
# test creatives instead of live ones.
VITE_ADMOB_TEST_DEVICE_IDS=

# Force test IDs at runtime even when real IDs are set (extra safety switch
# for CI / debug builds). "true" to enable.
VITE_USE_AD_TEST_IDS=
